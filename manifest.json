{
  "manifest_version": 3,
  "name": "LMSprint — LMS Bulk Downloader",
  "version": "2.0.0",
  "description": "Selectively bulk download PDFs and PowerPoint presentations (PPT, PPTX) from IIIT Kottayam LMS using your authenticated session.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://lmsug25.iiitkottayam.ac.in/*",
    "https://*.iiitkottayam.ac.in/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "LMSprint",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}